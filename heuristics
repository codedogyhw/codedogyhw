class CostEstimator:
    def __init__(self, global_info):
        self.global_info = global_info

    def calculate_h_score(self, current_marking, trace, trace_index):
        ka_set = self.global_info.ka_map.get(current_marking, set())

        if not ka_set:
            return 0

        remaining_trace = trace[trace_index:] if trace_index < len(trace) else []
        remaining_trace_set = set(remaining_trace)

        missing_count = 0
        for ka in ka_set:
            if ka not in remaining_trace_set:
                missing_count += 1

        return missing_count
